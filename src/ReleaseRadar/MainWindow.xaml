<Window x:Class="ReleaseRadar.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Release Radar" Width="1440" Height="960" MinWidth="1000" MinHeight="720" Background="{StaticResource CanvasBrush}"
        Foreground="#E9EDF4" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="#222B39" BorderThickness="0,0,0,1" Padding="30,21">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="How it works" Click="About_Click" Background="Transparent" BorderThickness="0" Margin="0,0,12,0"/>
          <Button x:Name="RefreshButton" Content="↻   Refresh calendar" Click="Refresh_Click" Background="#BED5FC" Foreground="#10213C" BorderBrush="#BED5FC" FontWeight="SemiBold"/>
          <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Image Width="42" Height="42" Margin="0,0,13,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Charmander">
            <Image.Source><BitmapImage UriSource="Assets/Charmander.png" DecodePixelHeight="168"/></Image.Source>
          </Image>
          <StackPanel><TextBlock Text="RELEASE RADAR" FontSize="17" FontWeight="Bold"/><TextBlock Text="Your next great game, on the calendar." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="30,24,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button x:Name="PreviousButton" Content="‹" FontSize="23" Padding="15,3" Click="Previous_Click" ToolTip="Previous month (Alt+Left)" AutomationProperties.Name="Previous month"/>
          <Button Content="Today" Click="Today_Click" Margin="8,0"/>
          <Button x:Name="NextButton" Content="›" FontSize="23" Padding="15,3" Click="Next_Click" ToolTip="Next month (Alt+Right)" AutomationProperties.Name="Next month"/>
        </StackPanel>
        <StackPanel><TextBlock x:Name="MonthTitle" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="MonthSubtitle" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,18">
        <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
        <WrapPanel>
          <TextBlock Text="●  HIGH  1–500" Foreground="#FF9DAA" FontSize="11" Margin="0,0,22,0"/>
          <TextBlock Text="●  MID  501–1,500" Foreground="#F6B176" FontSize="11" Margin="0,0,22,0"/>
          <TextBlock Text="●  LOWER  1,501+" Foreground="#92B4D5" FontSize="11" Margin="0,0,22,0"/>
          <TextBlock Text="EA  EARLY ACCESS LAUNCH" Foreground="#D9E1ED" FontSize="11" Margin="0,0,22,0"/>
          <TextBlock Text="1.0  FULL RELEASE FROM EARLY ACCESS" Foreground="#D9E1ED" FontSize="11" Margin="0,0,22,0"/>
          <TextBlock Text="🔥  TRENDING" Foreground="#D9E1ED" FontSize="11" ToolTip="At least 250 new followers AND 10% growth over seven days."/>
        </WrapPanel>
      </DockPanel>
      <Border x:Name="NoticeBorder" Grid.Row="2" Background="#192638" BorderBrush="#2E425E" BorderThickness="1" CornerRadius="7" Padding="13,10" Margin="0,0,0,14" Visibility="Collapsed">
        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#C1D3ED"/>
      </Border>
      <Grid Grid.Row="3">
        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Columns="7"><TextBlock Text="MON" Style="{x:Null}" Foreground="#929DAF" Margin="12,0" FontSize="11"/><TextBlock Text="TUE" Foreground="#929DAF" Margin="12,0" FontSize="11"/><TextBlock Text="WED" Foreground="#929DAF" Margin="12,0" FontSize="11"/><TextBlock Text="THU" Foreground="#929DAF" Margin="12,0" FontSize="11"/><TextBlock Text="FRI" Foreground="#929DAF" Margin="12,0" FontSize="11"/><TextBlock Text="SAT" Foreground="#68748A" Margin="12,0" FontSize="11"/><TextBlock Text="SUN" Foreground="#68748A" Margin="12,0" FontSize="11"/></UniformGrid>
        <ScrollViewer x:Name="CalendarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="Calendar_SizeChanged">
          <UniformGrid x:Name="CalendarGrid" Columns="7"/>
        </ScrollViewer>
      </Grid>
      <Expander Grid.Row="4" x:Name="UnconfirmedExpander" Foreground="#AEBBD0" Margin="0,14,0,0" Header="Date unconfirmed" IsExpanded="False">
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="UnconfirmedPanel" Margin="0,10,0,0"/></ScrollViewer>
      </Expander>
    </Grid>
    <Border Grid.Row="2" Background="#10151D" BorderBrush="#222B39" BorderThickness="0,1,0,0" Padding="30,12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="UpdatedText" DockPanel.Dock="Right" Foreground="#929DAF" FontSize="11"/><TextBlock x:Name="StatusText" Foreground="#A7B5CC" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/></DockPanel>
        <ProgressBar x:Name="RefreshProgress" Grid.Row="1" Height="2" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" Background="#243148" Foreground="#BCD3FA"/>
      </Grid>
    </Border>
    <Grid x:Name="ModalLayer" Grid.RowSpan="3" Background="#B8000000" Visibility="Collapsed" MouseDown="ModalBackdrop_Click">
      <Border Width="540" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#151C27" BorderBrush="#3B495E" BorderThickness="1" CornerRadius="16" Padding="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel Margin="0,0,0,22"><Button Content="×" DockPanel.Dock="Right" Click="CloseModal_Click" Padding="10,2" FontSize="20" AutomationProperties.Name="Close details"/><TextBlock x:Name="ModalEyebrow" Text="RELEASE DETAILS" Foreground="#94ADD0" FontSize="11" VerticalAlignment="Center"/></DockPanel>
          <TextBlock x:Name="ModalTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ModalDate" FontSize="14" Foreground="#B0BED1" Margin="0,10,0,20" TextWrapping="Wrap"/>
          <Border Background="#1E2939" CornerRadius="8" Padding="16" Margin="0,0,0,22"><TextBlock x:Name="ModalMetrics" TextWrapping="Wrap" FontSize="13" LineHeight="23" Foreground="#D4DEED"/></Border>
          <TextBlock x:Name="ModalBody" TextWrapping="Wrap" Foreground="#A7B5CC" FontSize="13" LineHeight="21" Margin="0,0,0,22"/>
          <Button x:Name="OutlookButton" Content="Create Outlook calendar event" Click="Outlook_Click" Background="#BED5FC" Foreground="#10213C" FontWeight="SemiBold" HorizontalContentAlignment="Center" Padding="15,13"/>
          <Button x:Name="LearnMoreButton" Content="Learn more  ↗" Click="LearnMore_Click" Margin="0,10,0,0" HorizontalContentAlignment="Center" Padding="15,13"/>
          <Button x:Name="ViewOnSteamButton" Content="View on Steam" Click="ViewOnSteam_Click" Margin="0,10,0,0" HorizontalContentAlignment="Center" Padding="15,13"/>
          <TextBlock x:Name="ActionStatus" Foreground="#C8D9F4" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
